{
  "cases": [
    {
      "name": "single_page_even_when_parallel_is_requested",
      "independent_units": 1,
      "explicit_parallel_request": true,
      "expected_mode": "current_workspace_serial"
    },
    {
      "name": "multiple_independent_pages_without_parallel_request",
      "independent_units": 3,
      "explicit_parallel_request": false,
      "expected_mode": "current_workspace_serial"
    },
    {
      "name": "multiple_pages_with_shared_file_ownership",
      "independent_units": 0,
      "candidate_units": 3,
      "explicit_parallel_request": true,
      "expected_mode": "current_workspace_serial"
    },
    {
      "name": "multiple_independent_modules_with_parallel_request",
      "independent_units": 3,
      "explicit_parallel_request": true,
      "config_parallel": false,
      "expected_mode": "one_worktree_and_one_commit_per_unit"
    },
    {
      "name": "config_parallel_is_an_explicit_request",
      "independent_units": 2,
      "explicit_parallel_request": false,
      "config_parallel": true,
      "expected_mode": "one_worktree_and_one_commit_per_unit"
    }
  ]
}
